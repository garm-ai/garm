# Build output. `go build ./cmd/<x>` drops a binary in the working directory
# named after the package, so each one is listed at the root as a backstop
# even though bin/ is the documented output path.
bin/
/garm
/protoc-gen-garm-go
/protoc-gen-garm-python

# Go workspace state. There is one module here now — the contract is an
# ordinary dependency at a released tag, not a nested module — so a go.work is
# a contributor's local business and neither file is committed. A committed
# workspace would also hide the one thing worth testing: that this module
# builds against the published contract rather than a checkout.
go.work
go.work.sum

# Where CI checks garm-ai/contracts out for the three tests that read its
# source. A contributor who clones it here instead of beside this repository
# should not commit it.
/.contracts/

# Test and coverage output
*.out
*.test
coverage.*

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# mise's local overrides — the committed mise.toml is the shared toolchain;
# mise.local.toml is for a contributor pinning something for themselves.
mise.local.toml
.mise.local.toml

# Catalogue artifacts are built, not committed. Running `garm catalogue
# build` while testing is the easy way to leave a multi-megabyte file here.
*.binpb
